# ==========================================
# Pustakeum (पुस्तकम्) .gitignore
# ==========================================

# --- Rust & Tauri Build Artifacts ---
/target/
**/target/
src-tauri/target/
src-tauri/gen/
**/*.rs.bk
*.pdb

# --- Node & Frontend Build Outputs ---
node_modules/
ui/node_modules/
ui/dist/
ui/dist-ssr/
*.local

# --- Package Manager Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Local Databases & User Data ---
pustakeum_data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example

# --- Operating System Caches ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Metadata ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosv
*.sln.docstates

